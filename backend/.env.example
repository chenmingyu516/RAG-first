# ============ 阿里云百炼（DashScope）配置 ============
# 必填：去 https://bailian.console.aliyun.com 开通后获取
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 大模型名称（可换：qwen-turbo 更便宜 / qwen-plus 均衡 / qwen-max 最强）
LLM_MODEL=qwen-plus

# 嵌入模型名称（把知识转成可检索的数字）
EMBEDDING_MODEL=text-embedding-v2

# 接口地址（若是"业务空间"账号，请改成你控制台里 apiHost 对应的地址）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ============ 检索参数 ============
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
SCORE_THRESHOLD=0.2

# ============ 安全 ============
# 生产环境请务必改成一串随机字符串（用于给登录令牌签名）
JWT_SECRET=please-change-me-to-a-random-secret-string
JWT_EXPIRE_MINUTES=1440

# ============ 管理员账号 ============
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
